# Copy this file to `.env` for local reference only - .NET does not load
# .env files natively. Use one of these instead, in order of preference:
#   1. dotnet user-secrets set "Section:Key" "value"   (local dev, never committed)
#   2. Real environment variables using double-underscore nesting,
#      e.g. TwelveData__ApiKey=xxxx (works with these exact names too)
#   3. appsettings.Production.json / your hosting platform's secret store (deployment)
#
# Never commit real values. This file lists variable names only.

# Twelve Data (FX / Metals / Energy candles) - https://twelvedata.com
# Either variable accepts one key or a comma-separated list, e.g.
# "key1,key2,key3" - keys are tried in order and rotated automatically if
# one fails (rate limit, plan restriction, etc). Provide at least one.
TwelveData__ApiKey=
TwelveData__ApiKeys=

# Finnhub (economic calendar) - https://finnhub.io
Finnhub__ApiKey=

# Alpha Vantage (news + sentiment) - https://www.alphavantage.co/support/#api-key
AlphaVantage__ApiKey=

# FRED (US macro context) - https://fred.stlouisfed.org/docs/api/api_key.html
# Not yet wired into any provider adapter.
Fred__ApiKey=

# Telegram Bot API - https://core.telegram.org/bots#how-do-i-create-a-bot
# BotToken from @BotFather; ChatId is the chat/user the bot should message.
# Wired up as plumbing only (POST /api/telegram/test) - no automated signal
# alerts are sent yet. See Providers/TelegramNotifier.cs for why.
Telegram__BotToken=
Telegram__ChatId=
