<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>50db58a4-9267-49cc-8765-555bf55ab22f</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lets the test project directly exercise SignalLogService's internal,
         dependency-free outcome-calculation logic (real money math like the
         weighted blended R below) without needing to stand up its full DI
         graph (TelegramNotifier, IHostEnvironment, disk-cache paths). -->
    <InternalsVisibleTo Include="RealtouchSmartTrade.Tests" />
  </ItemGroup>

</Project>
